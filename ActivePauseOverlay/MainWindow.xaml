<Window x:Class="ActivePauseOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False">
  <Grid x:Name="OverlayRoot" Background="Transparent">
    <Border Width="620"
            Padding="42"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="#FFE07800"
            BorderThickness="2"
            Background="#F0101318">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock x:Name="TitleText"
                   HorizontalAlignment="Center"
                   Foreground="#FFE07800"
                   FontFamily="Bahnschrift"
                   FontSize="42"
                   FontWeight="Bold"
                   Text="Break soon" />
        <TextBlock x:Name="MessageText"
                   Margin="0,16,0,0"
                   HorizontalAlignment="Center"
                   Foreground="#FFFFF3D6"
                   FontFamily="Bahnschrift"
                   FontSize="22"
                   TextAlignment="Center"
                   Text="The break starts in" />
        <TextBlock x:Name="CountdownText"
                   Margin="0,16,0,0"
                   HorizontalAlignment="Center"
                   Foreground="#FFFFF3D6"
                   FontFamily="Bahnschrift"
                   FontSize="58"
                   FontWeight="Bold"
                   Text="00:00:10" />
        <Button x:Name="SkipButton"
                Width="180"
                Margin="0,24,0,0"
                Padding="14,8"
                HorizontalAlignment="Center"
                Background="#FFE07800"
                BorderBrush="#FFE07800"
                Foreground="#FF101318"
                FontFamily="Bahnschrift"
                FontSize="18"
                FontWeight="Bold"
                Content="Skip"
                Visibility="Collapsed" />
        <Button x:Name="FinishButton"
                Width="180"
                Margin="0,24,0,0"
                Padding="14,8"
                HorizontalAlignment="Center"
                Background="#FFE07800"
                BorderBrush="#FFE07800"
                Foreground="#FF101318"
                FontFamily="Bahnschrift"
                FontSize="18"
                FontWeight="Bold"
                Content="Finish"
                Visibility="Collapsed" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
